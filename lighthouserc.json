{
  "ci": {
    "collect": {
      "//": "NEXT_PUBLIC_SITE_URL matches the origin under test so rel=canonical is same-origin and the SEO audit measures the real code path rather than a host mismatch.",
      "startServerCommand": "npm run start -- --port 3211",
      "startServerReadyPattern": "Ready in",
      "url": [
        "http://127.0.0.1:3211/en",
        "http://127.0.0.1:3211/ar",
        "http://127.0.0.1:3211/en/work",
        "http://127.0.0.1:3211/en/work/whatsapp-commerce",
        "http://127.0.0.1:3211/en/cv"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],

        "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],

        "uses-responsive-images": "error",
        "modern-image-formats": "error",
        "font-display": "error",

        "unused-javascript": ["warn", { "maxLength": 1 }],
        "unused-css-rules": "off",
        "csp-xss": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
