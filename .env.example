# Copy to .env.local for development, or .env.production on the VPS.
# Never commit the filled-in versions — .gitignore already covers them.

# --- Site -------------------------------------------------------------------
# Public origin, no trailing slash. Used for canonical URLs, OG images, sitemap.
NEXT_PUBLIC_SITE_URL="https://osamajenana.com"

# --- Contact form (Phase 1) -------------------------------------------------
# Resend API key. Sent over HTTPS API rather than SMTP so the VPS IP's
# reputation never affects deliverability. https://resend.com/api-keys
RESEND_API_KEY=""
# Verified sender on your domain, e.g. "Portfolio <noreply@osamajenana.com>"
CONTACT_FROM=""
# Where form submissions land.
CONTACT_TO=""

# --- GitHub stats (Phase 5) -------------------------------------------------
# Fine-grained PAT, read-only, public repo metadata only. No write scopes.
GITHUB_TOKEN=""

# --- Analytics (Phase 7) ----------------------------------------------------
# Self-hosted Umami. Leave blank to disable analytics entirely.
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
